---
import Layout from '../layouts/Layout.astro';
import TratamentoDistancia from '../components/TratamentoDistancia.astro';
---

<Layout title="Tratamento à Distância">
    <section class="py-12 md:py-24 px-4 bg-gray-50 min-h-screen">
        <div class="max-w-5xl mx-auto">
            <div class="mb-10 text-center md:text-left">
                <img src="/images/gept-logo-principal.png" alt="Logo GEPT" class="h-16 w-auto inline-block md:hidden mb-6">
            </div>
            
            <TratamentoDistancia transparent={true} />
        </div>
    </section>
</Layout>
