---
---
<div id="promo-popup" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity" id="popup-backdrop"></div>
    
    <!-- Modal Content -->
    <div class="relative w-full max-w-sm md:max-w-md bg-[#071a37] shadow-2xl rounded-3xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300 border border-white/15" id="popup-content">
        
        <!-- Close Button (Clear) -->
        <button id="popup-close" class="absolute top-3 right-3 z-20 flex items-center gap-1 bg-black/50 hover:bg-black/80 text-white px-3 py-1.5 rounded-full text-sm font-bold backdrop-blur-md transition shadow-lg border border-white/10" aria-label="Fechar">
            <span>Fechar</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

        <!-- Clickable campaign area -->
        <a id="popup-link" href="/efas" class="block group">
            <div class="relative bg-[#0b2549]">
                <img id="popup-image" src="/images/efas/efas-2026-cartaz.jpeg" alt="Cartaz oficial do EFAS 2026 em Uberlândia" class="w-full max-h-[58vh] object-contain bg-[#071a37]" />
                <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#071a37]/80 to-transparent pointer-events-none"></div>
            </div>

            <div class="relative px-6 pb-6 pt-4 text-center text-white bg-[radial-gradient(circle_at_top,rgba(243,198,93,0.15),transparent_50%)]">
                <p id="popup-eyebrow" class="text-[0.7rem] font-extrabold uppercase tracking-[0.16em] text-[#f3c65d]">12 e 13 de setembro • Uberlândia/MG</p>
                <h2 id="popup-title" class="mt-2 text-2xl md:text-3xl font-black">EFAS 2026</h2>
                <p id="popup-subtitle" class="mt-1 text-sm text-blue-100">Encontro Fraterno Auta de Souza</p>
                <span id="popup-cta" class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#f3c65d] px-7 py-3 text-sm font-black uppercase tracking-wider text-[#071a37] shadow-[0_10px_30px_rgba(243,198,93,0.25)] transition group-hover:-translate-y-0.5 group-hover:bg-[#ffe09a]">
                    Faça sua inscrição
                    <svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-5-5l5 5-5 5" /></svg>
                </span>
            </div>
        </a>
    </div>
</div>

<script>
    async function initPopup() {
        const popup = document.getElementById('promo-popup');
        const backdrop = document.getElementById('popup-backdrop');
        const content = document.getElementById('popup-content');
        const closeBtn = document.getElementById('popup-close');
        
        if (!popup || !content) return;

        // Fetch campaigns JSON and validate expiration & status
        try {
            const response = await fetch('/data/campaigns.json');
            if (!response.ok) return;
            const data = await response.json();
            const now = new Date();
            const currentPath = window.location.pathname;

            // Find active popup campaign valid for current page and time range
            const validCampaign = data.campaigns.find((c: any) => {
                if (!c.active || c.type !== 'popup') return false;
                
                // Expiration check
                if (c.startDate && new Date(c.startDate) > now) return false;
                if (c.expirationDate && new Date(c.expirationDate) < now) return false;

                // Page targeting check
                if (c.targetPages && !c.targetPages.includes('all')) {
                    const matches = c.targetPages.some((p: string) => p === currentPath || (p === '/' && (currentPath === '' || currentPath === '/')));
                    if (!matches) return false;
                }

                return true;
            });

            // If no valid campaign or campaign is expired, do not show popup
            if (!validCampaign) {
                return;
            }

            const campaignContent = validCampaign.content || {};
            const popupLink = document.getElementById('popup-link') as HTMLAnchorElement | null;
            const popupImage = document.getElementById('popup-image') as HTMLImageElement | null;
            const textFields: Record<string, string | undefined> = {
                'popup-eyebrow': campaignContent.eyebrow,
                'popup-title': campaignContent.title,
                'popup-subtitle': campaignContent.subtitle,
                'popup-cta': campaignContent.ctaText,
            };

            if (popupLink) popupLink.href = campaignContent.ctaLink || '#';
            if (popupImage) {
                popupImage.src = campaignContent.image || '/images/gept-logo-principal.png';
                popupImage.alt = campaignContent.imageAlt || validCampaign.title || 'Campanha em destaque';
            }
            Object.entries(textFields).forEach(([id, value]) => {
                const element = document.getElementById(id);
                if (element && value) element.firstChild!.textContent = value;
            });
        } catch (err) {
            console.error('Erro ao verificar validade da campanha de pop-up:', err);
            return;
        }
        
        // Show popup with a small delay to ensure rendering is complete
        requestAnimationFrame(() => {
            popup.classList.remove('hidden');
            popup.classList.add('flex');
            
            // Trigger animation
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 50);
        });
        
        const closePopup = () => {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                popup.classList.add('hidden');
                popup.classList.remove('flex');
            }, 300);
        };
        
        if (closeBtn) closeBtn.addEventListener('click', closePopup);
        if (backdrop) backdrop.addEventListener('click', closePopup);
    }

    // Try to init immediately if DOM is ready, otherwise wait
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPopup);
    } else {
        initPopup();
    }
</script>
