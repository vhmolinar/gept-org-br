---
---
<div id="promo-popup" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity" id="popup-backdrop"></div>
    
    <!-- Modal Content -->
    <div class="relative w-full max-w-md bg-[#00334e] shadow-2xl rounded-xl overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="popup-content">
        
        <!-- Close Button (Clear) -->
        <button id="popup-close" class="absolute top-3 right-3 z-20 flex items-center gap-1 bg-black/50 hover:bg-black/80 text-white px-3 py-1.5 rounded-full text-sm font-bold backdrop-blur-md transition shadow-lg border border-white/10" aria-label="Fechar">
            <span>Fechar</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>

        <!-- Clickable Banner Area -->
        <a href="/cursos-espiritismo#inscricao" class="block relative w-full aspect-[4/5] bg-cover bg-center group" style="background-image: url('/images/popup-divulgacao-cursos-bg.jpg');">
            <!-- Gradient Overlay (Dark blue to cyan to match the poster) -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#002235] via-[#004a63]/80 to-[#00334e]/70 group-hover:via-[#004a63]/70 transition-all duration-300"></div>
            
            <!-- Content -->
            <div class="relative h-full flex flex-col justify-center p-8 md:p-10 text-center">
                <!-- Top Question -->
                <h2 class="text-xl md:text-2xl font-bold text-white leading-tight mb-8 drop-shadow-md opacity-90">
                    De onde vim?<br>O que é a morte?<br>A reencarnação existe?
                </h2>
                
                <!-- Main Banner Title -->
                <div class="flex flex-col items-center mb-8">
                    <h3 class="text-white text-4xl md:text-5xl font-black uppercase tracking-wider leading-none drop-shadow-lg mb-3">
                        Conheça o<br>Espiritismo
                    </h3>
                    <div class="flex items-center gap-4 w-full justify-center">
                        <div class="h-px bg-cyan-400/50 flex-grow"></div>
                        <span class="text-cyan-200 text-xs md:text-sm font-bold tracking-widest uppercase">
                            Curso Presencial e Gratuito
                        </span>
                        <div class="h-px bg-cyan-400/50 flex-grow"></div>
                    </div>
                </div>
                
                <!-- Details -->
                <div class="mt-4 flex flex-col items-center gap-3">
                    <div class="flex flex-col items-center gap-1 text-white font-medium bg-white/10 px-6 py-3 rounded-xl border border-white/20 backdrop-blur-sm">
                        <div class="flex items-center gap-2 font-bold text-lg text-cyan-200">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
                            <span>Início: 15 de agosto</span>
                        </div>
                        <div class="text-sm">Horário: 17h15 às 20h</div>
                    </div>
                    
                    <div class="mt-4 inline-block bg-cyan-500 hover:bg-cyan-400 text-[#002235] px-8 py-3 rounded-full font-black text-sm uppercase tracking-wider shadow-[0_0_15px_rgba(6,182,212,0.5)] transition-transform transform group-hover:scale-105">
                        CLIQUE AQUI E SE INSCREVA
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<script>
    async function initPopup() {
        const popup = document.getElementById('promo-popup');
        const backdrop = document.getElementById('popup-backdrop');
        const content = document.getElementById('popup-content');
        const closeBtn = document.getElementById('popup-close');
        
        if (!popup || !content) return;

        // Fetch campaigns JSON and validate expiration & status
        try {
            const response = await fetch('/data/campaigns.json');
            if (!response.ok) return;
            const data = await response.json();
            const now = new Date();
            const currentPath = window.location.pathname;

            // Find active popup campaign valid for current page and time range
            const validCampaign = data.campaigns.find((c: any) => {
                if (!c.active || c.type !== 'popup') return false;
                
                // Expiration check
                if (c.startDate && new Date(c.startDate) > now) return false;
                if (c.expirationDate && new Date(c.expirationDate) < now) return false;

                // Page targeting check
                if (c.targetPages && !c.targetPages.includes('all')) {
                    const matches = c.targetPages.some((p: string) => p === currentPath || (p === '/' && (currentPath === '' || currentPath === '/')));
                    if (!matches) return false;
                }

                return true;
            });

            // If no valid campaign or campaign is expired, do not show popup
            if (!validCampaign) {
                return;
            }
        } catch (err) {
            console.error('Erro ao verificar validade da campanha de pop-up:', err);
            return;
        }
        
        // Show popup with a small delay to ensure rendering is complete
        requestAnimationFrame(() => {
            popup.classList.remove('hidden');
            popup.classList.add('flex');
            
            // Trigger animation
            setTimeout(() => {
                content.classList.remove('scale-95', 'opacity-0');
                content.classList.add('scale-100', 'opacity-100');
            }, 50);
        });
        
        const closePopup = () => {
            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                popup.classList.add('hidden');
                popup.classList.remove('flex');
            }, 300);
        };
        
        if (closeBtn) closeBtn.addEventListener('click', closePopup);
        if (backdrop) backdrop.addEventListener('click', closePopup);
    }

    // Try to init immediately if DOM is ready, otherwise wait
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPopup);
    } else {
        initPopup();
    }
</script>
