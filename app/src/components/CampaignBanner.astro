---
---

<div id="campaign-banner" class="hidden bg-[#00334e] text-white py-2.5 px-4 relative z-50 shadow-md">
    <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-3 text-sm font-medium">
        <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span id="campaign-banner-text">Inscrições abertas para os Cursos de Espiritismo! Início dia 15 de agosto.</span>
        </div>
        <div class="flex items-center gap-3">
            <a id="campaign-banner-cta" href="/cursos-espiritismo#inscricao" class="bg-cyan-500 hover:bg-cyan-400 text-[#002235] px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider transition">
                Saiba mais
            </a>
            <button id="campaign-banner-close" class="text-gray-300 hover:text-white p-1 rounded-full hover:bg-white/10 transition" aria-label="Fechar aviso">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </div>
</div>

<script>
    async function loadBannerCampaigns() {
        const bannerContainer = document.getElementById('campaign-banner');
        if (!bannerContainer) return;

        // Check if user dismissed banner during session
        if (sessionStorage.getItem('gept_banner_dismissed')) return;

        try {
            const res = await fetch('/data/campaigns.json');
            if (!res.ok) return;
            const data = await res.json();
            const now = new Date();

            const currentPath = window.location.pathname;

            const bannerCampaign = data.campaigns.find((c: any) => {
                if (!c.active || c.type !== 'banner') return false;
                
                if (c.startDate && new Date(c.startDate) > now) return false;
                if (c.expirationDate && new Date(c.expirationDate) < now) return false;

                if (c.targetPages && !c.targetPages.includes('all')) {
                    const match = c.targetPages.some((pagePath: string) => {
                        return pagePath === currentPath || (pagePath === '/' && currentPath === '');
                    });
                    if (!match) return false;
                }

                return true;
            });

            if (bannerCampaign && bannerCampaign.content) {
                const bannerText = document.getElementById('campaign-banner-text');
                const bannerCta = document.getElementById('campaign-banner-cta') as HTMLAnchorElement | null;
                const closeBtn = document.getElementById('campaign-banner-close');

                if (bannerText) bannerText.textContent = bannerCampaign.content.text || '';
                if (bannerCta) {
                    bannerCta.textContent = bannerCampaign.content.ctaText || 'Saiba mais';
                    bannerCta.href = bannerCampaign.content.ctaLink || '#';
                }

                bannerContainer.classList.remove('hidden');

                if (closeBtn) {
                    closeBtn.addEventListener('click', () => {
                        bannerContainer.classList.add('hidden');
                        sessionStorage.setItem('gept_banner_dismissed', 'true');
                    });
                }
            }
        } catch (err) {
            console.error('Erro ao carregar campanhas de banner:', err);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadBannerCampaigns);
    } else {
        loadBannerCampaigns();
    }
</script>
